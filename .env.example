# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# Django core
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (uses SQLite by default for local dev; switch to MySQL for staging/production)
# SQLite (local dev):
DATABASE_URL=sqlite:///db.sqlite3
# MySQL (Cloud SQL):
# DATABASE_URL=mysql://USER:PASSWORD@HOST/DB_NAME

# Google Cloud Storage (leave blank to use local filesystem in dev)
GCS_BUCKET_NAME=

# OpenAI
OPENAI_API_KEY=

# SendGrid
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=noreply@example.com
CONTACT_RECIPIENT_EMAIL=joseph@example.com

# Twilio (optional - SMS notification on contact form submission)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
