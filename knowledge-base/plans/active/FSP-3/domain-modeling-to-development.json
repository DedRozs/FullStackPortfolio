{
  "ticketId": "FSP-3",
  "sessionPath": "knowledge-base/plans/active/FSP-3/",
  "ubiquitousLanguage": [
    {
      "term": "ClientOrganization",
      "definition": "A company or client entity that owns projects; the top-level tenancy boundary in the portal"
    },
    {
      "term": "UserProfile",
      "definition": "A portal user - either a client stakeholder scoped to one ClientOrganization, or a staff/admin user with cross-org access"
    },
    {
      "term": "Stakeholder",
      "definition": "A client UserProfile belonging to a ClientOrganization; can view and act on that org's data only"
    },
    {
      "term": "Project",
      "definition": "A unit of work delivered to a ClientOrganization; lifecycle DRAFT -> ACTIVE -> PENDING_APPROVAL -> COMPLETE | ARCHIVED"
    },
    {
      "term": "Milestone",
      "definition": "A named checkpoint within a Project; lifecycle PENDING -> IN_PROGRESS -> COMPLETE"
    },
    {
      "term": "Deliverable",
      "definition": "A named artifact within a Milestone; versioned via DeliverableVersions"
    },
    {
      "term": "DeliverableVersion",
      "definition": "A numbered snapshot of a Deliverable submitted for review; version_number is unique per Deliverable"
    },
    {
      "term": "Approval",
      "definition": "A reviewer decision on a specific DeliverableVersion; states PENDING -> APPROVED | REJECTED | REVISION_REQUESTED"
    },
    {
      "term": "Approver",
      "definition": "A UserProfile authorized to grant, reject, or request revision on an Approval"
    },
    {
      "term": "Revision Requested",
      "definition": "ApprovalStatus indicating the reviewer requires changes before re-submission; does not permanently close the deliverable"
    },
    {
      "term": "FileRecord",
      "definition": "GCS file metadata attached to exactly one of: DeliverableVersion or Message (mutual exclusion enforced by invariant)"
    },
    {
      "term": "MessageThread",
      "definition": "A named conversation thread scoped to a Project"
    },
    {
      "term": "Message",
      "definition": "A single post within a MessageThread, sent by a UserProfile"
    },
    {
      "term": "InvoiceRecord",
      "definition": "A billing record for a ClientOrganization; lifecycle DRAFT -> SENT -> PAID | OVERDUE | CANCELLED"
    },
    {
      "term": "ActivityEvent",
      "definition": "An immutable append-only audit log entry recording a domain action with its actor, project, org, and payload"
    },
    {
      "term": "Money",
      "definition": "Immutable value: amount (Decimal >= 0) + ISO 4217 3-letter currency code"
    },
    {
      "term": "VersionNumber",
      "definition": "Immutable positive integer (>= 1) identifying a specific DeliverableVersion"
    },
    {
      "term": "FileMetadata",
      "definition": "Immutable value capturing content_type, size_bytes (> 0), and storage_key for an uploaded file"
    },
    {
      "term": "StakeholderRole",
      "definition": "Role classification of a UserProfile: CLIENT, STAFF, or ADMIN"
    },
    {
      "term": "Object-level permission",
      "definition": "A DRF permission that restricts access to records belonging to the caller's ClientOrganization; not just IsAuthenticated"
    },
    {
      "term": "Portal",
      "definition": "The React frontend at /portal/* where authenticated stakeholders interact with their projects, files, messages, and invoices"
    }
  ],
  "entities": [
    {
      "name": "ClientOrganization",
      "aggregateRoot": true,
      "identity": "UUID pk",
      "invariants": [
        "name must not be blank",
        "slug must not be blank"
      ],
      "stateTransitions": []
    },
    {
      "name": "UserProfile",
      "aggregateRoot": false,
      "identity": "UUID pk; OneToOne with Django User",
      "invariants": [
        "email must not be blank",
        "is_client=True requires organization_id to be set",
        "is_client=False requires organization_id=None"
      ],
      "stateTransitions": []
    },
    {
      "name": "Project",
      "aggregateRoot": true,
      "identity": "UUID pk",
      "invariants": [
        "name must not be blank"
      ],
      "stateTransitions": [
        "DRAFT -> ACTIVE via activate()",
        "ACTIVE -> PENDING_APPROVAL via submit_for_approval()",
        "PENDING_APPROVAL -> ACTIVE via return_to_active()",
        "PENDING_APPROVAL -> COMPLETE via mark_complete()",
        "ACTIVE | COMPLETE -> ARCHIVED via archive()"
      ]
    },
    {
      "name": "Milestone",
      "aggregateRoot": false,
      "identity": "UUID pk",
      "invariants": [
        "name must not be blank",
        "target_date must be set before begin()"
      ],
      "stateTransitions": [
        "PENDING -> IN_PROGRESS via begin()",
        "IN_PROGRESS -> COMPLETE via complete()"
      ]
    },
    {
      "name": "Deliverable",
      "aggregateRoot": false,
      "identity": "UUID pk",
      "invariants": [
        "name must not be blank"
      ],
      "stateTransitions": []
    },
    {
      "name": "DeliverableVersion",
      "aggregateRoot": false,
      "identity": "UUID pk; (deliverable_id, version_number) unique",
      "invariants": [
        "version_number >= 1",
        "(deliverable_id, version_number) must be unique"
      ],
      "stateTransitions": []
    },
    {
      "name": "Approval",
      "aggregateRoot": true,
      "identity": "UUID pk; OneToOne with DeliverableVersion",
      "invariants": [
        "rejection requires non-blank comment",
        "revision request requires non-blank comment",
        "one Approval per DeliverableVersion"
      ],
      "stateTransitions": [
        "PENDING -> APPROVED via approve(comment?)",
        "PENDING -> REJECTED via reject(comment required)",
        "PENDING -> REVISION_REQUESTED via request_revision(comment required)"
      ]
    },
    {
      "name": "MessageThread",
      "aggregateRoot": true,
      "identity": "UUID pk",
      "invariants": [
        "subject must not be blank"
      ],
      "stateTransitions": []
    },
    {
      "name": "Message",
      "aggregateRoot": false,
      "identity": "UUID pk",
      "invariants": [
        "body must not be blank"
      ],
      "stateTransitions": []
    },
    {
      "name": "FileRecord",
      "aggregateRoot": false,
      "identity": "UUID pk",
      "invariants": [
        "filename not blank",
        "storage_path not blank",
        "mime_type not blank",
        "file_size_bytes > 0",
        "exactly one of deliverable_version_id or message_id must be set (XOR)"
      ],
      "stateTransitions": []
    },
    {
      "name": "InvoiceRecord",
      "aggregateRoot": true,
      "identity": "UUID pk",
      "invariants": [
        "amount must be positive",
        "due_date required before send()"
      ],
      "stateTransitions": [
        "DRAFT -> SENT via send() (due_date required)",
        "SENT -> PAID via mark_paid()",
        "SENT -> OVERDUE via mark_overdue()"
      ]
    },
    {
      "name": "ActivityEvent",
      "aggregateRoot": false,
      "identity": "UUID pk; append-only, never mutated",
      "invariants": [
        "event_type must not be blank"
      ],
      "stateTransitions": []
    }
  ],
  "valueObjects": [
    {
      "name": "Money",
      "fields": [
        "amount: Decimal (>= 0)",
        "currency: str (ISO 4217, exactly 3 alpha chars)"
      ],
      "immutable": true
    },
    {
      "name": "FileMetadata",
      "fields": [
        "content_type: str (not blank)",
        "size_bytes: int (> 0)",
        "storage_key: str (not blank)"
      ],
      "immutable": true
    },
    {
      "name": "VersionNumber",
      "fields": [
        "value: int (>= 1)"
      ],
      "immutable": true
    },
    {
      "name": "ProjectStatus",
      "fields": [
        "DRAFT",
        "ACTIVE",
        "PENDING_APPROVAL",
        "COMPLETE",
        "ARCHIVED"
      ],
      "immutable": true
    },
    {
      "name": "MilestoneStatus",
      "fields": [
        "PENDING",
        "IN_PROGRESS",
        "COMPLETE"
      ],
      "immutable": true
    },
    {
      "name": "ApprovalStatus",
      "fields": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "REVISION_REQUESTED"
      ],
      "immutable": true
    },
    {
      "name": "InvoiceStatus",
      "fields": [
        "DRAFT",
        "SENT",
        "PAID",
        "OVERDUE",
        "CANCELLED"
      ],
      "immutable": true
    },
    {
      "name": "StakeholderRole",
      "fields": [
        "CLIENT",
        "STAFF",
        "ADMIN"
      ],
      "immutable": true
    }
  ],
  "aggregates": [
    {
      "root": "Project",
      "members": [
        "Milestone",
        "Deliverable",
        "DeliverableVersion"
      ],
      "invariants": [
        "Milestone.project_id must reference this root",
        "Deliverable.milestone_id must reference a Milestone in this aggregate",
        "DeliverableVersion.deliverable_id must reference a Deliverable in this aggregate"
      ]
    },
    {
      "root": "ClientOrganization",
      "members": [
        "UserProfile"
      ],
      "invariants": [
        "Client UserProfile.organization_id must equal this root's id"
      ]
    },
    {
      "root": "Approval",
      "members": [],
      "invariants": [
        "One Approval per DeliverableVersion (OneToOne constraint)"
      ]
    },
    {
      "root": "InvoiceRecord",
      "members": [],
      "invariants": [
        "amount must be positive",
        "due_date must be set before transitioning to SENT"
      ]
    },
    {
      "root": "MessageThread",
      "members": [
        "Message",
        "FileRecord"
      ],
      "invariants": [
        "Message.thread_id must reference this root",
        "FileRecord.message_id (when set) must reference a Message in this thread",
        "subject must not be blank"
      ]
    }
  ],
  "domainEvents": [
    {
      "name": "ClientOrganizationRegistered",
      "trigger": "RegisterClientOrganization use case",
      "payload": [
        "organization_id: UUID",
        "name: str",
        "slug: str",
        "occurred_at: datetime"
      ]
    },
    {
      "name": "UserProfileCreated",
      "trigger": "CreateUserProfile use case",
      "payload": [
        "user_profile_id: UUID",
        "is_client: bool",
        "organization_id: UUID | None",
        "occurred_at: datetime"
      ]
    },
    {
      "name": "ProjectActivated",
      "trigger": "ActivateProject use case",
      "payload": [
        "project_id: UUID",
        "organization_id: UUID",
        "name: str",
        "occurred_at: datetime"
      ]
    },
    {
      "name": "ProjectSubmittedForApproval",
      "trigger": "SubmitProjectForApproval use case",
      "payload": [
        "project_id: UUID",
        "organization_id: UUID",
        "occurred_at: datetime"
      ]
    },
    {
      "name": "ProjectReturnedToActive",
      "trigger": "RejectProject or RejectApproval triggering project revert",
      "payload": [
        "project_id: UUID",
        "organization_id: UUID",
        "occurred_at: datetime"
      ]
    },
    {
      "name": "ProjectCompleted",
      "trigger": "ApproveProject use case",
      "payload": [
        "project_id: UUID",
        "organization_id: UUID",
        "occurred_at: datetime"
      ]
    },
    {
      "name": "ProjectArchived",
      "trigger": "ArchiveProject use case",
      "payload": [
        "project_id: UUID",
        "organization_id: UUID",
        "occurred_at: datetime"
      ]
    },
    {
      "name": "MilestoneStarted",
      "trigger": "Milestone.begin() via StartMilestone use case",
      "payload": [
        "milestone_id: UUID",
        "project_id: UUID",
        "organization_id: UUID",
        "name: str",
        "target_date: date",
        "occurred_at: datetime"
      ]
    },
    {
      "name": "MilestoneCompleted",
      "trigger": "CompleteMilestone use case",
      "payload": [
        "milestone_id: UUID",
        "project_id: UUID",
        "organization_id: UUID",
        "name: str",
        "occurred_at: datetime"
      ]
    },
    {
      "name": "DeliverableRevisionSubmitted",
      "trigger": "AddDeliverableVersion use case",
      "payload": [
        "deliverable_id: UUID",
        "deliverable_version_id: UUID",
        "version_number: int",
        "milestone_id: UUID",
        "project_id: UUID",
        "occurred_at: datetime"
      ]
    },
    {
      "name": "DeliverableApproved",
      "trigger": "GrantApproval use case",
      "payload": [
        "deliverable_id: UUID",
        "deliverable_version_id: UUID",
        "approval_id: UUID",
        "reviewer_id: UUID",
        "comment: str | None",
        "milestone_id: UUID",
        "project_id: UUID",
        "occurred_at: datetime"
      ]
    },
    {
      "name": "DeliverableRejected",
      "trigger": "RejectApproval use case",
      "payload": [
        "deliverable_id: UUID",
        "deliverable_version_id: UUID",
        "approval_id: UUID",
        "reviewer_id: UUID",
        "comment: str",
        "milestone_id: UUID",
        "project_id: UUID",
        "occurred_at: datetime"
      ]
    },
    {
      "name": "DeliverableRevisionRequested",
      "trigger": "RequestRevision use case (on Approval)",
      "payload": [
        "deliverable_id: UUID",
        "deliverable_version_id: UUID",
        "approval_id: UUID",
        "reviewer_id: UUID",
        "comment: str",
        "milestone_id: UUID",
        "project_id: UUID",
        "occurred_at: datetime"
      ]
    },
    {
      "name": "FileRecordUploaded",
      "trigger": "UploadFile use case",
      "payload": [
        "file_record_id: UUID",
        "filename: str",
        "mime_type: str",
        "file_size_bytes: int",
        "uploaded_by_id: UUID",
        "deliverable_version_id: UUID | None",
        "message_id: UUID | None",
        "occurred_at: datetime"
      ]
    },
    {
      "name": "MessagePosted",
      "trigger": "SendMessage use case",
      "payload": [
        "message_id: UUID",
        "thread_id: UUID",
        "project_id: UUID",
        "sender_id: UUID",
        "occurred_at: datetime"
      ]
    },
    {
      "name": "InvoiceSent",
      "trigger": "InvoiceRecord.send()",
      "payload": [
        "invoice_record_id: UUID",
        "organization_id: UUID",
        "amount_cents: int",
        "due_date: date",
        "occurred_at: datetime"
      ]
    },
    {
      "name": "InvoicePaid",
      "trigger": "InvoiceRecord.mark_paid()",
      "payload": [
        "invoice_record_id: UUID",
        "organization_id: UUID",
        "occurred_at: datetime"
      ]
    },
    {
      "name": "InvoiceMarkedOverdue",
      "trigger": "InvoiceRecord.mark_overdue()",
      "payload": [
        "invoice_record_id: UUID",
        "organization_id: UUID",
        "occurred_at: datetime"
      ]
    }
  ],
  "repositoryInterfaces": [
    {
      "name": "ClientOrganizationRepository",
      "methods": [
        "get_by_id(organization_id: UUID) -> ClientOrganization | None",
        "get_by_slug(slug: str) -> ClientOrganization | None",
        "save(organization: ClientOrganization) -> None",
        "list_all() -> Sequence[ClientOrganization]"
      ]
    },
    {
      "name": "UserProfileRepository",
      "methods": [
        "get_by_id(profile_id: UUID) -> UserProfile | None",
        "get_by_user_id(user_id: int) -> UserProfile | None",
        "save(profile: UserProfile) -> None",
        "list_stakeholders_for_organization(organization_id: UUID) -> Sequence[UserProfile]"
      ]
    },
    {
      "name": "ProjectRepository",
      "methods": [
        "get_by_id(project_id: UUID) -> Project | None",
        "save(project: Project) -> None",
        "list_by_organization(organization_id: UUID) -> Sequence[Project]",
        "list_by_status(status: ProjectStatus) -> Sequence[Project]"
      ]
    },
    {
      "name": "MilestoneRepository",
      "methods": [
        "get_by_id(milestone_id: UUID) -> Milestone | None",
        "save(milestone: Milestone) -> None",
        "list_by_project(project_id: UUID) -> Sequence[Milestone]"
      ]
    },
    {
      "name": "DeliverableRepository",
      "methods": [
        "get_by_id(deliverable_id: UUID) -> Deliverable | None",
        "save(deliverable: Deliverable) -> None",
        "list_by_milestone(milestone_id: UUID) -> Sequence[Deliverable]"
      ]
    },
    {
      "name": "DeliverableVersionRepository",
      "methods": [
        "get_by_id(version_id: UUID) -> DeliverableVersion | None",
        "save(version: DeliverableVersion) -> None",
        "list_by_deliverable(deliverable_id: UUID) -> Sequence[DeliverableVersion]"
      ]
    },
    {
      "name": "ApprovalRepository",
      "methods": [
        "get_by_id(approval_id: UUID) -> Approval | None",
        "get_by_deliverable_version(deliverable_version_id: UUID) -> Approval | None",
        "save(approval: Approval) -> None"
      ]
    },
    {
      "name": "FileRecordRepository",
      "methods": [
        "get_by_id(file_record_id: UUID) -> FileRecord | None",
        "save(file_record: FileRecord) -> None",
        "list_by_deliverable_version(deliverable_version_id: UUID) -> Sequence[FileRecord]",
        "list_by_message(message_id: UUID) -> Sequence[FileRecord]"
      ]
    },
    {
      "name": "MessageThreadRepository",
      "methods": [
        "get_by_id(thread_id: UUID) -> MessageThread | None",
        "save(thread: MessageThread) -> None",
        "list_by_project(project_id: UUID) -> Sequence[MessageThread]"
      ]
    },
    {
      "name": "MessageRepository",
      "methods": [
        "get_by_id(message_id: UUID) -> Message | None",
        "save(message: Message) -> None",
        "list_by_thread(thread_id: UUID) -> Sequence[Message]"
      ]
    },
    {
      "name": "InvoiceRecordRepository",
      "methods": [
        "get_by_id(invoice_id: UUID) -> InvoiceRecord | None",
        "save(invoice: InvoiceRecord) -> None",
        "list_by_organization(organization_id: UUID) -> Sequence[InvoiceRecord]",
        "list_by_status(status: InvoiceStatus) -> Sequence[InvoiceRecord]"
      ]
    },
    {
      "name": "ActivityEventRepository",
      "methods": [
        "save(event: ActivityEvent) -> None",
        "list_by_project(project_id: UUID) -> Sequence[ActivityEvent]",
        "list_by_organization(organization_id: UUID) -> Sequence[ActivityEvent]"
      ]
    }
  ],
  "domainServices": [
    {
      "name": "ProjectProgressEvaluator",
      "responsibility": "Determines whether all milestones for a project are COMPLETE; guards project completion transitions that span the Project and Milestone aggregates",
      "methods": [
        "all_milestones_complete(project_id: UUID, milestone_repo: MilestoneRepository) -> bool"
      ]
    },
    {
      "name": "ActivityEventRecorder",
      "responsibility": "Creates and persists ActivityEvent entries as a cross-cutting concern for write operations across all aggregates",
      "methods": [
        "record(event_type: str, actor_id: UUID, project_id: UUID | None, organization_id: UUID | None, payload: dict, activity_repo: ActivityEventRepository) -> ActivityEvent"
      ]
    }
  ],
  "applicationLayer": {
    "useCases": [
      {
        "name": "RegisterClientOrganization",
        "deps": [
          "ClientOrganizationRepository",
          "ActivityEventRepository"
        ],
        "execute": "(cmd: RegisterClientOrganizationCommand) -> ClientOrganizationDTO"
      },
      {
        "name": "CreateUserProfile",
        "deps": [
          "UserProfileRepository",
          "ClientOrganizationRepository"
        ],
        "execute": "(cmd: CreateUserProfileCommand) -> UserProfileDTO"
      },
      {
        "name": "CreateProject",
        "deps": [
          "ProjectRepository",
          "ClientOrganizationRepository",
          "ActivityEventRepository"
        ],
        "execute": "(cmd: CreateProjectCommand) -> ProjectDTO"
      },
      {
        "name": "ActivateProject",
        "deps": [
          "ProjectRepository",
          "ActivityEventRepository"
        ],
        "execute": "(cmd: ActivateProjectCommand) -> ProjectDTO"
      },
      {
        "name": "SubmitProjectForApproval",
        "deps": [
          "ProjectRepository",
          "ActivityEventRepository"
        ],
        "execute": "(cmd: SubmitProjectForApprovalCommand) -> ProjectDTO"
      },
      {
        "name": "ApproveProject",
        "deps": [
          "ProjectRepository",
          "ActivityEventRepository"
        ],
        "execute": "(cmd: ApproveProjectCommand) -> ProjectDTO"
      },
      {
        "name": "RejectProject",
        "deps": [
          "ProjectRepository",
          "ActivityEventRepository"
        ],
        "execute": "(cmd: RejectProjectCommand) -> ProjectDTO"
      },
      {
        "name": "RequestRevision",
        "deps": [
          "ApprovalRepository",
          "ActivityEventRepository"
        ],
        "execute": "(cmd: RequestRevisionCommand) -> ApprovalDTO"
      },
      {
        "name": "CreateMilestone",
        "deps": [
          "MilestoneRepository",
          "ProjectRepository"
        ],
        "execute": "(cmd: CreateMilestoneCommand) -> MilestoneDTO"
      },
      {
        "name": "CompleteMilestone",
        "deps": [
          "MilestoneRepository",
          "ActivityEventRepository"
        ],
        "execute": "(cmd: CompleteMilestoneCommand) -> MilestoneDTO"
      },
      {
        "name": "AddDeliverableVersion",
        "deps": [
          "DeliverableRepository",
          "DeliverableVersionRepository",
          "ActivityEventRepository"
        ],
        "execute": "(cmd: AddDeliverableVersionCommand) -> DeliverableVersionDTO"
      },
      {
        "name": "RequestApproval",
        "deps": [
          "DeliverableVersionRepository",
          "ApprovalRepository",
          "ActivityEventRepository"
        ],
        "execute": "(cmd: RequestApprovalCommand) -> ApprovalDTO"
      },
      {
        "name": "GrantApproval",
        "deps": [
          "ApprovalRepository",
          "ActivityEventRepository"
        ],
        "execute": "(cmd: GrantApprovalCommand) -> ApprovalDTO"
      },
      {
        "name": "RejectApproval",
        "deps": [
          "ApprovalRepository",
          "ActivityEventRepository"
        ],
        "execute": "(cmd: RejectApprovalCommand) -> ApprovalDTO"
      },
      {
        "name": "UploadFile",
        "deps": [
          "FileRecordRepository",
          "GCSFileStoragePort",
          "ActivityEventRepository"
        ],
        "execute": "(cmd: UploadFileCommand) -> FileRecordDTO"
      },
      {
        "name": "ListFilesForDeliverable",
        "deps": [
          "FileRecordRepository"
        ],
        "execute": "(query: ListFilesForDeliverableQuery) -> list[FileRecordDTO]"
      },
      {
        "name": "SendMessage",
        "deps": [
          "MessageRepository",
          "MessageThreadRepository",
          "ActivityEventRepository"
        ],
        "execute": "(cmd: SendMessageCommand) -> MessageDTO"
      },
      {
        "name": "ListMessages",
        "deps": [
          "MessageRepository",
          "MessageThreadRepository"
        ],
        "execute": "(query: ListMessagesQuery) -> list[MessageDTO]"
      },
      {
        "name": "ListInvoices",
        "deps": [
          "InvoiceRecordRepository"
        ],
        "execute": "(query: ListInvoicesQuery) -> list[InvoiceRecordDTO]"
      },
      {
        "name": "ListActivityEvents",
        "deps": [
          "ActivityEventRepository"
        ],
        "execute": "(query: ListActivityEventsQuery) -> list[ActivityEventDTO]"
      }
    ],
    "dtos": [
      {
        "name": "RegisterClientOrganizationCommand",
        "fields": [
          "name: str",
          "slug: str"
        ]
      },
      {
        "name": "CreateUserProfileCommand",
